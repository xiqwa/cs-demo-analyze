{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoundMind CS2",
  "version": "0.1.0",
  "identifier": "com.roundmind.cs2",
  "build": {
    "beforeDevCommand": "npm run dev -w apps/web",
    "beforeBuildCommand": "npm run build -w apps/web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RoundMind CS2",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": false
  }
}